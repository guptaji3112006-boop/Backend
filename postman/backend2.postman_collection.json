{
  "info": {
    "name": "Backend2 - All Routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All declared Express routes plus video search example. Import the environment, select it, configure credentials, then run requests individually. Register requires an avatar; login saves tokens; create requests save IDs. Cleanup deletes data. Known controller bugs are documented on affected requests. Assertions expect success and will expose these failures. No live API verification has been performed."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP response is successful (2xx)', function () {",
          " pm.expect(pm.response.code).to.be.within(200, 299);",
          "});",
          "pm.test('Response is JSON', function () {",
          " pm.response.json();",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/healthcheck/",
            "description": "Uses the route currently declared in src/routes. Requires bearer authentication unless marked public.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Users",
      "item": [
        {
          "name": "Register user (select avatar file)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/register",
            "description": "Avatar is required. Select a local image in Body > form-data. Cover image is optional. Uses Cloudinary.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fullname",
                  "value": "{{fullname}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "coverImage",
                  "type": "file",
                  "src": [],
                  "disabled": true
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const r = pm.response.json();",
                  "  const d = r.data && typeof r.data === 'object' ? r.data : r.message;",
                  "  if (d && d._id) pm.environment.set('userId', d._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (save tokens and user ID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/login",
            "description": "Provide both username and email: the current controller queries both together. Saves tokens and userId into the selected environment.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  " const d = pm.response.json().data;",
                  " pm.test('Login returns access token', () => pm.expect(d.accessToken).to.be.a('string').and.not.empty);",
                  " if(d.accessToken) pm.environment.set('accessToken',d.accessToken);",
                  " if(d.refreshToken) pm.environment.set('refreshToken',d.refreshToken);",
                  " if(d.user && d.user._id) pm.environment.set('userId',d.user._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/current-user",
            "description": "Uses the route currently declared in src/routes. Requires bearer authentication unless marked public."
          },
          "response": [],
